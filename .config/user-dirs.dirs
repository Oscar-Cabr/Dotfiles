# ~/.config/user-dirs.dirs
#
# XDG well-known user directories. GLib reads this file DIRECTLY
# (g_get_user_special_dir), so every GTK app, Nemo and the file chooser
# get their answers from here. No package is needed to make it work.
#
# Written by hand, deliberately NOT generated by xdg-user-dirs-update.
#
# Convention: pointing an entry at $HOME means "disabled"; apps hide it.
#
# Format: shell-style, $HOME is the only variable expanded, no ~.

XDG_DESKTOP_DIR="$HOME/Desktop"
XDG_DOCUMENTS_DIR="$HOME/Documents"
XDG_DOWNLOAD_DIR="$HOME/Downloads"
XDG_PICTURES_DIR="$HOME/Images"
XDG_VIDEOS_DIR="$HOME/Movies"
XDG_MUSIC_DIR="$HOME"
XDG_TEMPLATES_DIR="$HOME"
XDG_PUBLICSHARE_DIR="$HOME"
